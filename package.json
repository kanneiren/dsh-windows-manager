{
  "name": "dsh-windows-manager",
  "version": "0.4.0",
  "description": "Install and control DeepSeek Harness on Windows and WSL2 from a native Windows tray application.",
  "keywords": [
    "deepseek",
    "harness",
    "windows",
    "wsl2",
    "tray",
    "manager"
  ],
  "license": "MIT",
  "author": "DeepSeek Harness Manager contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanneiren/dsh-windows-manager.git"
  },
  "bugs": {
    "url": "https://github.com/kanneiren/dsh-windows-manager/issues"
  },
  "homepage": "https://github.com/kanneiren/dsh-windows-manager#readme",
  "type": "commonjs",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "dsh-windows-manager": "bin/dsh-windows-manager.js"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/Install.ps1",
    "scripts/Uninstall.ps1",
    "docs/",
    "CHANGELOG.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "SECURITY.md",
    "SECURITY.en.md",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts\\Build.ps1 -SkipTests",
    "test": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts\\Test.ps1",
    "test:cli": "node tests/cli.test.mjs",
    "pack:check": "node scripts/Verify-Package.mjs",
    "prepack": "npm run build && npm run pack:check",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
